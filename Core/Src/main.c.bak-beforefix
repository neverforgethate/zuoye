/**
  * @brief  This function is executed in case of error occurrence.
  * @retval None
  */
void Error_Handler(void)
{
  /* USER CODE BEGIN Error_Handler_Debug */
  /* User can add his own implementation to report the HAL error return state */
  __disable_irq();
  while (1)
  {
    uint32_t now = HAL_GetTick();

    /* 1. 按键事件：只处理事件标志，这里不做任何阻塞 */
    if (Key_TakeEvent(KEY_DIR))
    {
      App_ToggleDir();
    }
    if (Key_TakeEvent(KEY_PAUSE))
    {
      App_ToggleRun();
    }

    /* 2. 串口数据包：收满一包才处理；帧头/校验/范围任一不对就不执行 */
    {
      Packet_t pkt;
      if (Packet_TryTake(&pkt))
      {
        uint16_t step = (uint16_t)(pkt.step_l | ((uint16_t)pkt.step_h << 8));
        if (pkt.head == PKT_HEAD &&
            Packet_Check(&pkt) &&
            pkt.run <= 1 &&
            pkt.dir <= 1 &&
            step >= STEP_MIN && step <= STEP_MAX)
        {
          App_Apply(pkt.run, pkt.dir, step);
        }
      }
    }

    /* 3. 流水灯节拍：用时间戳比较，不用 HAL_Delay，主循环永远不阻塞 */
    if (g_app.run)
    {
      if ((now - s_last_shift) >= g_app.step_ms)
      {
        s_last_shift = now;
        g_app.led    = LED_Next(g_app.led, g_app.dir);
        LED_Show(g_app.led);
        Oled_Refresh(1);      /* 屏幕上的 LED 编号要跟着变；串口不要求每次切灯都发 */
      }
    }
    else
    {
      s_last_shift = now;       /* 暂停时持续对齐，恢复后不会立刻乱跳 */
    }

    /* 4. 状态有变化 → 刷新灯 + 刷屏 + 标记要发反馈 */
    if (App_TakeChanged())
    {
      LED_Show(g_app.led);
      Oled_Refresh(1);
      FB_MarkDirty();
    }

    /* 5. 串口反馈：空闲时才启动发送 */
    FB_Poll();


  }
  /* USER CODE END Error_Handler_Debug */
}
